# Browser key (HTTP-referrer restricted): Maps JavaScript API, Places API (New), Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Node backend (see backend/) — server key and admin password live in backend/.env
NEXT_PUBLIC_API_URL=http://localhost:4000
# OneSignal App ID (public). Leave empty to disable web push.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# Safari web push ID from the OneSignal dashboard (optional)
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=
